# Copy to server/.env. This file is ignored by Git.
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATA_DIR=./data

# Default local demo. Change to supabase after applying both SQL files.
STORAGE_MODE=file
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy aliases supported: SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# Keys come from your own project's Connect dialog. Never use VITE_* for secrets.

ENABLE_SSE=true
SSE_HEARTBEAT_INTERVAL_MS=15000
TELEMETRY_TICK_INTERVAL_MS=3000
ENABLE_AUTO_TELEMETRY=true
